# PostgreSQL connection string (local dev via docker-compose or local PG)
# In production (Supabase): pooled connection, port 6543, pgbouncer=true — used by the app at runtime.
DATABASE_URL="postgresql://werent:werent@localhost:5432/werent?schema=public"

# Direct (non-pooled) connection string, port 5432 — used only by `prisma migrate`.
# Local dev: same as DATABASE_URL. Supabase: required, since the pooler can't run migrations.
DIRECT_URL="postgresql://werent:werent@localhost:5432/werent?schema=public"

# API server port
PORT=3000

# CORS origins (comma-separated) — restrict in production
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
